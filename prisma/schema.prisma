generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINEE
  GYM
}

enum GymClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  SUPPORT
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String                @id @default(cuid())
  password             String?
  location             String?
  name                 String?
  email                String?               @unique
  emailVerified        DateTime?             @map("email_verified")
  image                String?
  role                 Role?
  isAdmin              Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  termsAcceptedAt      DateTime?
  privacyAcceptedAt    DateTime?
  accounts             Account[]
  sessions             Session[]
  gymAccesses          GymAccess[]
  gymClaims            GymClaim[]
  gymClaimsReviewed    GymClaim[]            @relation("GymClaimReviewer")
  gymInvitesCreated    GymInvite[]           @relation("GymInviteCreator")
  gymFavorites         GymFavorite[]
  landingEvents        LandingEvent[]
  nutritionCustomFoods NutritionCustomFood[]
  nutritionEntries     NutritionEntry[]
  bodyweightEntries    BodyweightEntry[]
  nutritionSettings    NutritionSettings?

  @@index([deletedAt])
}

model LegalDocumentVersion {
  id               String            @id @default(cuid())
  type             LegalDocumentType
  title            String
  content          Json
  version          Int
  isCurrent        Boolean           @default(false)
  originalFileName String?
  originalFileUrl  String?
  sourceMimeType   String?
  uploadedByEmail  String
  createdAt        DateTime          @default(now())
  publishedAt      DateTime?

  @@unique([type, version])
  @@index([type, isCurrent])
  @@index([type, publishedAt])
}

model Gym {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  address           String
  phone             String         @default("")
  website           String         @default("")
  isVerified        Boolean        @default(false)
  verifiedAt        DateTime?
  verifiedByEmail   String?
  verificationRequired Boolean      @default(false)
  verificationSections String[]     @default([])
  verificationBaseline Json?
  isPublished       Boolean        @default(true)
  gymType           String?
  city              String?
  state             String?
  country           String?
  lat               Float?
  lng               Float?
  amenities         String[]       @default([])
  equipment         String[]       @default([])
  dayPassPrice      Float?
  dayPassDetails    String?
  dayPassUrl        String?
  dayPassOptions    Json           @default("[]")
  membershipPrice   Float?
  membershipDetails String?
  membershipOptions Json           @default("[]")
  hours             String?
  contactEmail      String?
  coverPhotoUrl     String?
  photoUrls         String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  access            GymAccess[]
  claims            GymClaim[]
  invites           GymInvite[]
  favorites         GymFavorite[]
  landingEvents     LandingEvent[]

  @@index([name])
  @@index([isPublished, isVerified])
}

model GymAccess {
  id              String   @id @default(cuid())
  gym             Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId           String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  assignedByEmail String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([gymId, userId])
  @@index([userId])
}

model GymClaim {
  id           String         @id @default(cuid())
  gym          Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId        String
  claimant     User           @relation(fields: [claimantId], references: [id], onDelete: Cascade)
  claimantId   String
  status       GymClaimStatus @default(PENDING)
  businessRole String?
  evidence     String?
  proposedData Json?
  reviewNote   String?
  reviewedBy   User?          @relation("GymClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt

  @@unique([gymId, claimantId])
  @@index([status, createdAt])
  @@index([claimantId])
}

model GymInvite {
  id           String    @id @default(cuid())
  gym          Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId        String
  tokenHash    String    @unique
  createdBy    User      @relation("GymInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  proposedData Json?
  createdAt    DateTime  @default(now())

  @@index([gymId, expiresAt])
}

model GymFavorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId     String
  createdAt DateTime @default(now())

  @@unique([userId, gymId])
  @@index([gymId])
}

model LandingEvent {
  id         String   @id @default(cuid())
  eventType  String
  visitorId  String
  visitId    String
  path       String   @default("/")
  gym        Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  gymId      String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  metadata   Json?
  dedupeKey  String?  @unique
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([visitorId, createdAt])
  @@index([visitId])
  @@index([gymId, createdAt])
  @@index([userId, createdAt])
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

model NutritionCustomFood {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  grams     Float
  kcal      Float
  p         Float
  c         Float
  f         Float
  createdAt DateTime         @default(now())
  entries   NutritionEntry[]

  @@index([userId, name])
}

model NutritionEntry {
  id           String               @id @default(cuid())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         DateTime
  meal         MealType
  customFood   NutritionCustomFood? @relation(fields: [customFoodId], references: [id])
  customFoodId String?
  foodName     String
  servings     Float
  kcal         Float
  p            Float
  c            Float
  f            Float
  time         String?
  createdAt    DateTime             @default(now())

  @@index([userId, date])
  @@index([userId, meal, date])
}

model BodyweightEntry {
  id     String   @id @default(cuid())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  date   DateTime
  weight Float

  @@unique([userId, date])
  @@index([userId, date])
}

model NutritionSettings {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String   @unique
  goalKcal      Float    @default(2800)
  goalProtein   Float    @default(200)
  goalFat       Float    @default(80)
  goalCarb      Float    @default(300)
  heatmapLevels Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PendingSignup {
  email        String   @id
  passwordHash String
  gymId        String?
  intent       String   @default("day-pass")
  visitorId    String?
  visitId      String?
  clickedAt    String?
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expires])
}
