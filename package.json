{
  "name": "browsegyms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-next.mjs .next-dev && NEXT_DIST_DIR=.next-dev next dev",
    "build": "node scripts/clean-next.mjs .next && next build",
    "start": "next start",
    "lint": "next lint",
    "media:r2:smoke-test": "node scripts/r2-smoke-test.mjs",
    "media:migrate:dry-run": "node scripts/migrate-uploadthing-to-r2.mjs",
    "media:migrate:apply": "node scripts/migrate-uploadthing-to-r2.mjs --apply",
    "db:replace-current": "prisma db push --accept-data-loss && prisma db execute --schema prisma/schema.prisma --file prisma/seed-current-gyms.sql && prisma db execute --schema prisma/schema.prisma --file prisma/reset-migration-history.sql && prisma migrate resolve --applied 20260824000000_current_product_baseline",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "3.932.0",
    "@hookform/resolvers": "^5.1.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/leaflet": "^1.9.22",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "next": "^15.5.18",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.60.0",
    "resend": "^6.4.1",
    "sanitize-html": "^2.17.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.6",
    "prisma": "^6.11.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3"
  }
}
